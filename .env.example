# Copy to engine/.env (engine) and set the Vercel-only values in Vercel. Never commit real values.
SCENARIO_ID=eaton
STDB_URI=https://maincloud.spacetimedb.com        # http://localhost:3000 offline / for dev
STDB_DB=emberline
STDB_TOKEN=                                       # engine identity token (spec/04 §3)
OPERATOR_PIN=                                     # typed once into dashboard and /control
ASSET_PORT=8787
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=                               # if set, briefings go via OpenRouter (bearer auth) instead of ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=                               # e.g. https://openrouter.ai/api; empty = api.anthropic.com
EMBERLINE_BRIEFING_MODEL=                         # empty = claude-sonnet-5-5; OpenRouter: anthropic/claude-sonnet-5.5
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_VERSION=                                 # value of the required Cartesia-Version header (see docs)
DUTY_OFFICER_NUMBERS=                             # E.164, comma-separated; local only, never in the hub
FIRMS_MAP_KEY=
LANDFIRE_EMAIL=
EMBERLINE_PROFILE=online                          # online | offline
# Vercel only: XAI_API_KEY, ANTHROPIC_API_KEY, STDB_URI, STDB_DB, STDB_SERVICE_TOKEN, CARTESIA_WEBHOOK_SECRET, GEMINI_API_KEY (P2)

# Dashboard only: public hub and asset coordinates. No engine/service token in VITE_*.
VITE_DATA_SOURCE=file                              # file | stdb (explicit)
VITE_SCENARIO_ID=fixture
VITE_ASSET_BASE=/
VITE_STDB_URI=http://127.0.0.1:3017
VITE_STDB_DB=phase-e-demo
# Hub operator PIN is entered into the page and kept in memory, never bundled.
