{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["react", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/data/**/*.ts",
    "src/contracts.ts",
    "src/forecast/**/*.ts",
    "src/forecast/**/*.tsx",
    "src/lib/maplibre.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
