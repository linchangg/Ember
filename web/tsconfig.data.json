{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["react"]
  },
  "include": ["src/data/**/*.ts", "src/contracts.ts"],
  "exclude": ["src/data/**/*.test.ts"]
}
